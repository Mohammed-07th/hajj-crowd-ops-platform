# Copy to .env and fill in. .env is gitignored and must never be committed.
#   cp .env.example .env

# --- OpenRouter (generation only; retrieval is entirely local) -------------
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL_PRIMARY=nvidia/nemotron-3-ultra-550b-a55b:free
LLM_MODEL_FALLBACKS=google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free,inclusionai/ling-3.0-flash:free,openai/gpt-oss-20b:free
OPENROUTER_SITE_URL=https://github.com/Mohammed-07th/hajj-crowd-ops-platform
OPENROUTER_APP_NAME=hajj-crowd-ops-platform
LLM_MAX_RETRIES=5
LLM_TIMEOUT_SECONDS=120

# --- local models (no key needed) ------------------------------------------
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384
# English-only cross-encoder, chosen for a 16 GB fanless build (90 MB vs 1.1 GB
# for BAAI/bge-reranker-base). See docs/RAG_DESIGN.md for the Arabic caveat.
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- infrastructure --------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=hajj_sop_v1
DELTA_ROOT=./delta
OPENLINEAGE_NAMESPACE=hajj-ops
# File transport: real OpenLineage events serialised as JSON, one per line.
OPENLINEAGE_EVENTS_PATH=./docs/evidence/lineage/events.jsonl
PII_SALT=change-me-in-production

# --- retrieval tuning ------------------------------------------------------
RRF_K=60
RETRIEVE_TOP_K=50
RERANK_TOP_K=5
